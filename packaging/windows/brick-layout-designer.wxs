<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v4 manifest for the Brick Layout Designer MSI.

  Minimal proper-installer shape:
   - Installs everything under  %ProgramFiles%\Brick Layout Designer\
   - Creates a Start menu shortcut
   - Registers a shared "App Paths" entry so `brick-layout-designer`
     on cmd.exe finds the binary without full-path PATH surgery
   - Associates .bbm files with the app (Explorer double-click passes
     the path as the first argument)

  The payload is the CMake install tree (exe + Qt runtime + MSVC
  runtime + parts library + translations) copied into staging\ by the
  workflow. scripts/harvest-wix.py mirrors it into Harvested.wxs.

  Build with:  wix build -d Version=X.Y.Z brick-layout-designer.wxs Harvested.wxs
  Version must change on every release or MajorUpgrade can't replace
  the previous install.

  Unsigned unless the release workflow's signing secrets are set (see
  docs/SIGNING.md); unsigned installs show an "unknown publisher"
  SmartScreen warning ("More info -> Run anyway" proceeds normally).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Brick Layout Designer"
           Manufacturer="Brick Layout Designer contributors"
           Version="$(var.Version)"
           UpgradeCode="7d5c9ad0-1b8a-4c2f-8b1f-7e6c1a3b5f4d"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Cross-platform maintainer fork of BlueBrick" />

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />

    <!-- Embed the .cab into the MSI so a single file is enough to install. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Standard "Application" shortcut in the Start menu. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Brick Layout Designer" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Brick Layout Designer" />
    </StandardDirectory>

    <!-- Main app component: the exe + a Start menu shortcut.
         The rest of the payload (Qt DLLs, parts library) is pulled
         in by the Harvested.wxs component group. -->
    <ComponentGroup Id="MainAppComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="*">
        <File Id="BrickLayoutDesignerExe"
              Source="staging\brick-layout-designer.exe"
              KeyPath="yes">
          <Shortcut Id="AppShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="Brick Layout Designer"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes" />
        </File>
        <ProgId Id="BrickLayoutDesigner.bbm"
                Description="BlueBrick Map"
                Icon="BrickLayoutDesignerExe"
                IconIndex="0">
          <Extension Id="bbm" ContentType="application/x-bluebrick-map">
            <Verb Id="open" TargetFile="BrickLayoutDesignerExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\brick-layout-designer.exe"
                       Value="[INSTALLFOLDER]brick-layout-designer.exe"
                       Type="string" />
      </Component>
      <Component Id="StartMenuDirComponent"
                 Directory="ApplicationProgramsFolder"
                 Guid="b3d2e4f1-5a6c-4a8e-91f1-c0a7d4e8b2a3">
        <RemoveFolder Id="CleanupStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="SOFTWARE\BrickLayoutDesigner"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Brick Layout Designer" Level="1">
      <ComponentGroupRef Id="MainAppComponents" />
      <!-- `HarvestedComponents` comes from scripts/harvest-wix.py: the
           staged support files (Qt runtime, parts library, translations). -->
      <ComponentGroupRef Id="HarvestedComponents" />
    </Feature>

  </Package>
</Wix>
