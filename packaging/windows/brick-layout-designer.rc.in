// Configured by src/app/CMakeLists.txt — icon + version resource for the exe.
#include <winver.h>

IDI_ICON1 ICON "@PROJECT_SOURCE_DIR@/packaging/icons/brick-layout-designer.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Brick Layout Designer contributors"
            VALUE "FileDescription",  "Brick Layout Designer"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "brick-layout-designer"
            VALUE "LegalCopyright",   "GPL-3.0; derivative of BlueBrick (c) Alban Nanty and contributors"
            VALUE "OriginalFilename", "brick-layout-designer.exe"
            VALUE "ProductName",      "Brick Layout Designer"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
