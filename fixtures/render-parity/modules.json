{
  "about": "Module frames and names as both apps draw them (web moduleLabels.ts, desktop rendering/ModuleLabels.cpp). Scene px at 8 px per stud; a name is charWidth x font px wide per character so fonts do not matter. Same file in both repos.",
  "charWidth": 0.6,
  "style": {
    "frameStroke": "rgba(100,180,255,0.8)",
    "frameDash": [
      6,
      4
    ],
    "nameFill": "rgba(100,180,255,0.9)",
    "nameStroke": "rgba(0,0,0,0.6)",
    "nameFontStyle": "bold",
    "nameStrokeWidth": "max(2, fontPx / 12)"
  },
  "cases": [
