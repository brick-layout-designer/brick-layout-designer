{
  "about": "Module frames and names as both apps draw them (web moduleLabels.ts, desktop rendering/ModuleLabels.cpp). Scene px at 8 px per stud; a name is charWidth x font px wide per character so fonts do not matter. A name is never longer than the side it sits on: it wraps to two lines, then shrinks (not under minFontPx), then is cut short with an ellipsis. A module with some parts on a hidden sheet frames only the parts that show, dashed with partlyHiddenFrameDash. Same file in both repos.",
  "charWidth": 0.6,
  "minFontPx": 16,
  "style": {
    "frameStroke": "rgba(100,180,255,0.8)",
    "frameDash": [
      6,
      4
    ],
    "partlyHiddenFrameDash": [
      2,
      6
    ],
    "nameFill": "rgba(100,180,255,0.9)",
    "nameStroke": "rgba(0,0,0,0.6)",
    "nameFontStyle": "bold",
    "nameStrokeWidth": "max(2, fontPx / 12)",
    "nameLineHeight": 1,
    "customFrameAlpha": 0.8,
    "customNameAlpha": 0.9,
    "fullNameBackground": "rgba(0,0,0,0.75)",
    "fullNamePad": "round(fontPx / 4)"
  },
  "looks": [
    {
      "module": {},
      "expect": {
        "frameStroke": "rgba(100,180,255,0.8)",
        "nameFill": "rgba(100,180,255,0.9)",
        "showName": true
      }
    },
    {
      "module": {
        "outlineColor": "#ff8800",
        "nameColor": "#ff8800"
      },
      "expect": {
        "frameStroke": "rgba(255,136,0,0.8)",
        "nameFill": "rgba(255,136,0,0.9)",
        "showName": true
      }
    },
    {
      "module": {
        "outlineColor": "#22c55e",
        "nameColor": "#1e293b",
        "sameColor": false,
        "showName": false
      },
      "expect": {
        "frameStroke": "rgba(34,197,94,0.8)",
        "nameFill": "rgba(30,41,59,0.9)",
        "showName": false
      }
    },
    {
      "module": {
        "outlineColor": "not a colour"
      },
      "expect": {
        "frameStroke": "rgba(100,180,255,0.8)",
        "nameFill": "rgba(100,180,255,0.9)",
        "showName": true
      }
    }
  ],
  "fit": [
